# Copy this file to .env.local for local development.

# true = connect to the real FastAPI + PostgreSQL backend (face recognition).
# false or missing = sample/demo data only.
VITE_LIVE_BACKEND=true

# Backend address during local development (uvicorn on your laptop).
# Leave EMPTY when the website is served by the backend itself (hosted version).
VITE_BACKEND_URL=http://127.0.0.1:8000
